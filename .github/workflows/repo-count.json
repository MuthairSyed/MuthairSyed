name: Update Repository Count

on:
  workflow_dispatch:
  schedule:
    - cron: "0 */6 * * *"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Get repository count
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          COUNT=$(gh api users/MuthairSyed --jq '.public_repos')

          echo "Current repositories: $COUNT"

          cat > repo-count.json <<EOF
          {
            "schemaVersion": 1,
            "label": "REPOSITORIES",
            "message": "$COUNT",
            "color": "00FF9C",
            "labelColor": "111827"
          }
          EOF

      - name: Commit changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add repo-count.json

          if git diff --cached --quiet; then
            echo "No changes."
          else
            git commit -m "chore: update repository count"
            git push
          fi
